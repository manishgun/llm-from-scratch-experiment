{
  "name": "minigpt-lab",
  "version": "1.0.0",
  "description": "A decoder-only Transformer built from scratch in TypeScript, with a workbench for training it, inspecting attention, and comparing seeded runs.",
  "main": "dist/backend/api/server.js",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"tsx watch src/backend/api/server.ts\" \"vite\"",
    "dev:backend": "tsx watch src/backend/api/server.ts",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.build.json",
    "start": "node dist/backend/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "train": "tsx src/backend/training/cliTrain.ts",
    "gradient-check": "tsx src/backend/training/cliTrain.ts --gradient-check",
    "download:data": "tsx src/backend/dataset/downloadData.ts",
    "verify": "npm run typecheck && npm test"
  },
  "keywords": [
    "llm",
    "transformer",
    "gpt",
    "attention",
    "from-scratch",
    "tensorflow",
    "typescript",
    "machine-learning",
    "educational",
    "backpropagation"
  ],
  "author": "MiniGPT Lab",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
